<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Contenido principal -->
    <LinearLayout
        android:id="@+id/containerPrincipal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background">

        <!-- Barra superior con gradiente -->
        <LinearLayout
            android:id="@+id/barraSuperior"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/gradiente_barra"
            android:padding="14dp"
            android:gravity="center_vertical"
            android:elevation="6dp">

            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:tint="@color/white"
                android:contentDescription="Menú" />

            <TextView
                android:id="@+id/textNombreApp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Innova TV"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.03" />

            <ImageButton
                android:id="@+id/btnBuscar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_search"
                android:tint="@color/white"
                android:contentDescription="Buscar" />
        </LinearLayout>

        <!-- Pestañas con indicador -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/surface"
            android:elevation="2dp">

            <LinearLayout
                android:id="@+id/tabLiveContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="14dp">

                <TextView
                    android:id="@+id/tabLive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EN VIVO"
                    android:textColor="@color/primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <View
                    android:id="@+id/indicadorLive"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="20dp"
                    android:background="@color/primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabMoviesContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="14dp">

                <TextView
                    android:id="@+id/tabMovies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PELÍCULAS"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <View
                    android:id="@+id/indicadorMovies"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginHorizontal="20dp"
                    android:background="@color/primary"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>

        <!-- Categorías scrolleables -->
        <HorizontalScrollView
            android:id="@+id/scrollCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:scrollbars="none"
            android:paddingVertical="6dp">

            <LinearLayout
                android:id="@+id/containerCategorias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp" />
        </HorizontalScrollView>

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/progressMain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="32dp"
            android:visibility="gone" />

        <!-- Mensaje vacío -->
        <TextView
            android:id="@+id/textVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No hay contenido disponible"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:visibility="gone" />

        <!-- Grid de canales -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCanales"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="6dp"
            android:clipToPadding="false" />

    </LinearLayout>

    <!-- Menú lateral (drawer) -->
    <LinearLayout
        android:id="@+id/menuLateral"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/surface">

        <!-- Cabecera del menú -->
        <LinearLayout
            android:id="@+id/cabeceraMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/gradiente_menu"
            android:padding="24dp">

            <ImageView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/ic_logo"
                android:contentDescription="Logo" />

            <TextView
                android:id="@+id/menuUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Usuario"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/menuServidor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Servidor"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/menuVencimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:background="#40FFFFFF" />
        </LinearLayout>

        <!-- Opciones -->
        <TextView
            android:id="@+id/menuInicio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp"
            android:text="🏠   Inicio"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/menuAjustes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp"
            android:text="⚙️   Ajustes"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:background="?android:attr/selectableItemBackground" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/border" />

        <TextView
            android:id="@+id/menuCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp"
            android:text="🚪   Cerrar sesión"
            android:textColor="@color/error"
            android:textSize="15sp"
            android:background="?android:attr/selectableItemBackground" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>