<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:gravity="center"
    android:padding="32dp">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/ic_logo"
        android:contentDescription="Logo" />

    <TextView
        android:id="@+id/textTituloVencida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Cuenta vencida"
        android:textColor="@color/error"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/textFechaVencimiento"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text=""
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Contactá a tu proveedor para renovar tu suscripción."
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:gravity="center" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContactar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:layout_marginTop="32dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:text="Contactar a mi proveedor"
        android:textSize="15sp"
        android:maxLines="2"
        android:gravity="center"
        android:backgroundTint="@color/primary_dark"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCerrarSesionVencida"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="Cerrar sesión"
        android:textSize="16sp"
        android:backgroundTint="@color/surface_variant" />

</LinearLayout>